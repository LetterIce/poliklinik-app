# ==========================================
# phpMyAdmin on patched PHP
# ==========================================
# SECURITY: CVE-2026-109618 / CVE-2026-109619 (CVSS 4.0 9.2 CRITICAL)
#   RCE via OOM corruption + stale global state in the PHP core engine.
#   Patched in PHP 8.4.27 / 8.3.36 (released 2026-10-21).
#
# The upstream phpmyadmin image still shipped PHP 8.3.35 (unpatched), and the
# official docker.io/library/php images had not published an arm64 manifest for
# 8.3.36 yet. PHP therefore comes from the Debian trixie-security repository,
# which ships php8.4 8.4.27-1~deb13u1 for arm64.
FROM debian:trixie

ARG PMA_VERSION=5.2.3

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    apache2 \
    libapache2-mod-php8.4 \
    php8.4-cli \
    php8.4-mysql \
    php8.4-mbstring \
    php8.4-xml \
    php8.4-curl \
    php8.4-zip \
    php8.4-gd \
    php8.4-intl \
    php8.4-bcmath \
    php8.4-opcache \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# phpMyAdmin release
RUN curl -fsSL -o /tmp/phpmyadmin.tar.xz \
      "https://files.phpmyadmin.net/phpMyAdmin/${PMA_VERSION}/phpMyAdmin-${PMA_VERSION}-all-languages.tar.xz" \
    && mkdir -p /var/www/html \
    && tar -xJf /tmp/phpmyadmin.tar.xz -C /var/www/html --strip-components=1 \
    && rm -f /tmp/phpmyadmin.tar.xz \
    && mkdir -p /var/lib/phpmyadmin \
    && chown -R www-data:www-data /var/lib/phpmyadmin /var/www/html

# phpMyAdmin configuration
COPY docker/phpmyadmin/config.php /etc/phpmyadmin/config.php
COPY docker/phpmyadmin/apache.conf /etc/apache2/conf-available/phpmyadmin.conf

RUN a2enconf phpmyadmin \
    && a2enmod rewrite \
    && sed -ri 's!^Listen 80$!Listen 80!' /etc/apache2/ports.conf

# Hardening (PHP): keep request sizes inside memory_limit so the OOM path
# that CVE-2026-109618 abuses stays unreachable.
RUN printf '%s\n' \
    '[PHP]' \
    'memory_limit = 128M' \
    'post_max_size = 8M' \
    'upload_max_filesize = 8M' \
    'max_input_vars = 200' \
    'expose_php = Off' \
    'display_errors = Off' \
    'log_errors = On' \
    > /etc/php/8.4/apache2/conf.d/99-hardening.ini

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1/ >/dev/null || exit 1
